# ElevenLabs — powers spoken questions, read-back, explanations and speech-to-text.
# Without a key, ClearForm falls back to the browser's built-in speech engine.
ELEVENLABS_API_KEY=
# Optional: override the default warm, calm voice.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5

# Linkup — trusted explanation and official form-guidance layer.
# Without a key, ClearForm uses its built-in plain-language glossary.
LINKUP_API_KEY=
